# ============================================================
# VUDANHDULARKVIP-WEB — Environment configuration
# ============================================================
# Copy file này thành .env.local và fill giá trị thật.
# .env.local KHÔNG được commit lên git (đã trong .gitignore).

# ─── NextAuth ─────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here-replace-this
NEXTAUTH_URL=http://localhost:3000

# ─── GitHub OAuth ─────────────────────────────────────────────
# Tạo OAuth App tại https://github.com/settings/developers
# - Application name: VUDANHDULARKVIP-WEB
# - Homepage URL: http://localhost:3000
# - Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder

# Comma-separated GitHub usernames được phép login.
# Để rỗng = mọi user đều login được (dev mode).
ALLOWED_GITHUB_USERS=vudanhdu2

# ─── V2 Python repo paths ─────────────────────────────────────
# Đường dẫn tương đối tới repo VUDANHDULARKVIP (Python)
V2_REPO_PATH=../vddclonelark-v2
PYTHON_BIN=python

# Caches của V2 (read-only)
V2_TRANSLATION_CACHE_DB=../vddclonelark-v2/.cache/translations.sqlite
V2_PERSISTENT_QUEUE_DB=../vddclonelark-v2/.cache/persistent_queue.db
V2_CRAWL_CHECKPOINT_DB=../vddclonelark-v2/.cache/crawl_checkpoint.db

# ─── Web app's own DB ─────────────────────────────────────────
WEB_DB_URL=file:./.web-cache/web.db

# ─── Lark Base (proxy cho admin records UI) ───────────────────
LARK_BASE_TOKEN=
LARK_TABLE_ID=
LARK_OPEN_URL=https://open.larksuite.com/open-apis
LARK_APP_ID=
LARK_APP_SECRET=
